# Server
PORT=3000
NODE_ENV=development

# Database (Prisma / PostgreSQL via Supabase Supavisor)
DATABASE_URL=postgresql://postgres.<project-ref>:password@localhost:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:password@localhost:5432/postgres

# Supabase — access tokens are verified against ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://<project-ref>.supabase.co

# Prayer check-in window. Defaults match Part 5 / Part 7 (open at Jamaah, 30 minutes).
PRAYER_WINDOW_DURATION_MINUTES=30
PRAYER_WINDOW_OPEN_OFFSET_MINUTES=0

