# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
# Cloud Run injects PORT itself in production — this default is for local dev.
PORT=3000
NODE_ENV=development

# Database (Prisma → Supabase Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/call_of_salah

# Supabase (database connection above, plus Auth + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Cloud Messaging (push notifications only — auth is Supabase's job)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
