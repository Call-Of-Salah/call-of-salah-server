# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=3000
NODE_ENV=development
API_VERSION=v1
TZ=UTC

# Supabase (managed PostgreSQL + Auth + Storage) — Architecture v2
DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Firebase Cloud Messaging only (push). Auth is Supabase Auth, not Firebase Auth.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# App
APP_BASE_URL=https://app.callofsalah.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Pilot: Redis/BullMQ deferred — rate limits & nonces live in Postgres.
# Reintroduce when scale requires it:
# REDIS_URL=redis://localhost:6379
