node_modules/
dist/
build/

# src/generated/ is deliberately NOT ignored — see AGENTS.md "Generated client".

# pnpm is the only package manager here — a lockfile from npm means someone ran the
# wrong command, so keep it out of commits.
package-lock.json
yarn.lock

# Environment / secrets
.env
.env.*.local
.env.local

# Logs
*.log
npm-debug.log*

# Prisma
prisma/migrations/dev.db

# Testing
coverage/

# Docker (keep the Dockerfile itself, just ignore local overrides)
docker-compose.override.yml

# Product specs (Parts 1-14, Architecture v2, etc.). Local only, never commit.
# Tracked markdown under docs/ (RUNNING_LOCALLY, IMPLEMENTATION_PLAN) stays in git.
docs/*.pdf

# Local Supabase JWT signing keys (private). Never commit.
supabase/signing_keys.json
supabase/signing_key.json

# macOS
.DS_Store
