{
  "name": "call-of-salah-server",
  "version": "0.1.0",
  "private": true,
  "description": "The backend API for Call of Salah.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.22.0"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "predev": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,node -c blue,green \"tsc --watch -p tsconfig.build.json --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "start": "node dist/index.js",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:seed": "node dist/scripts/seed.js",
    "db:init": "supabase init && supabase telemetry disable",
    "db:start": "supabase start",
    "db:stop": "supabase stop"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "prisma": "7.10.0",
    "supabase": "^2.115.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
