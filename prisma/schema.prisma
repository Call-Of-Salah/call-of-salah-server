generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_EMAIL_VERIFY
  PENDING_PARENTAL_CONSENT
  PENDING_ID_VERIFICATION
  PARENT_ACTIVE
  ID_VERIFIED
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum PrayerName {
  FAJR
  DHUHR
  ASR
  MAGHRIB
  ISHA
}

/// admin_user_id is a bare UUID column (no FK yet) — admin_users doesn't exist in the
/// schema yet. Wire up the relation once that table lands.
model Masjid {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String   @db.VarChar(100)
  addressLine1         String   @map("address_line1") @db.VarChar(100)
  addressLine2         String?  @map("address_line2") @db.VarChar(100)
  city                 String   @db.VarChar(60)
  postcode             String   @db.VarChar(10)
  latitude             Float    @db.DoublePrecision
  longitude            Float    @db.DoublePrecision
  geofenceRadiusMetres Int      @default(200) @map("geofence_radius_metres")
  adminUserId          String?  @map("admin_user_id") @db.Uuid
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       User[]
  prayerTimes MasjidPrayerTime[]

  @@map("masajid")
}

/// Admin-set Jamaah times per masjid per date. Window close is jamaat + 30 minutes in the service (KAN-28).
model MasjidPrayerTime {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  masjidId   String     @map("masjid_id") @db.Uuid
  date       DateTime   @db.Date
  prayer     PrayerName
  jamaatTime DateTime   @map("jamaat_time") @db.Time(0)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  masjid Masjid @relation(fields: [masjidId], references: [id])

  @@unique([masjidId, date, prayer], map: "uq_prayer_time")
  @@index([masjidId, date], map: "idx_prayer_times_lookup")
  @@map("masjid_prayer_times")
}

/// Thin identity row for JWT verification (KAN-65). Full Part 6 profile lands with onboarding.
model User {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUid   String        @unique @map("auth_uid") @db.VarChar(128)
  status    AccountStatus @default(PENDING_EMAIL_VERIFY)
  role      UserRole      @default(USER)
  masjidId  String        @map("masjid_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  masjid Masjid @relation(fields: [masjidId], references: [id])

  @@index([masjidId], map: "idx_users_masjid")
  @@index([status], map: "idx_users_status")
  @@map("users")
}
