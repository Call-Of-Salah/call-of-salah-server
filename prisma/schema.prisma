// Call of Salah — Part 6 data model (Prisma).
// Pilot DB: Supabase managed PostgreSQL 15+ (Architecture Overview v2).
// Auth identity lives in Supabase Auth; `auth_uid` stores the Supabase user id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING_PHONE_VERIFY
  PENDING_PARENTAL_CONSENT
  PENDING_ID_VERIFICATION
  ID_VERIFIED
  SUSPENDED
  DELETION_PENDING
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum PrayerName {
  FAJR
  DHUHR
  ASR
  MAGHRIB
  ISHA
}

enum MicroStreakPrayer {
  FAJR
  DHUHR
  ASR
  MAGHRIB
  ISHA
  JUMUAH
}

enum QuestType {
  PRAYER_COUNT
  PRAYER_STREAK
  FULL_DAY_COUNT
  TOTAL_CHECKINS
  JUMUAH_STREAK
}

model User {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumber          String        @unique @map("phone_number") @db.VarChar(20)
  phoneVerified        Boolean       @default(false) @map("phone_verified")
  email                String?       @unique @db.VarChar(255)
  firstName            String        @map("first_name") @db.VarChar(40)
  lastName             String        @map("last_name") @db.VarChar(40)
  username             String        @unique @db.VarChar(20)
  avatarId             String        @default("avatar_01") @map("avatar_id") @db.VarChar(20)
  dateOfBirth          DateTime      @map("date_of_birth") @db.Date
  masjidId             String        @map("masjid_id") @db.Uuid
  status               AccountStatus @default(PENDING_PHONE_VERIFY)
  role                 UserRole      @default(USER)
  xpTotal              Int           @default(0) @map("xp_total")
  creditsBalance       Int           @default(0) @map("credits_balance")
  totalCheckins        Int           @default(0) @map("total_checkins")
  referralCode         String        @unique @map("referral_code") @db.VarChar(16)
  referredByUserId     String?       @map("referred_by_user_id") @db.Uuid
  referralCredited     Boolean       @default(false) @map("referral_credited")
  googleUid            String?       @unique @map("google_uid") @db.VarChar(128)
  authUid              String        @unique @map("auth_uid") @db.VarChar(128)
  notificationsEnabled Boolean       @default(true) @map("notifications_enabled")
  deletionScheduledAt  DateTime?     @map("deletion_scheduled_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  masjid                 Masjid                 @relation(fields: [masjidId], references: [id])
  referredBy             User?                  @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referralsMade          User[]                 @relation("UserReferrals")
  deviceTokens           DeviceToken[]
  notificationPrefs      NotificationPreference?
  parentalConsent        ParentalConsent?
  checkins               Checkin[]
  mainStreak             MainStreak?
  microStreaks           PrayerMicroStreak[]
  leagueMembership       LeagueMembership?
  leagueWeeklyResults    LeagueWeeklyResult[]
  userBadges             UserBadge[]
  questProgress          UserQuestProgress[]
  redemptions            Redemption[]
  friendRequestsFrom     FriendRequest[]        @relation("FriendRequestFrom")
  friendRequestsTo       FriendRequest[]        @relation("FriendRequestTo")
  referralsAsReferrer    Referral[]             @relation("Referrer")
  referralsAsReferee     Referral[]             @relation("Referee")

  @@index([masjidId], map: "idx_users_masjid")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model DeviceToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  fcmToken   String   @map("fcm_token")
  platform   String   @db.VarChar(10)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("device_tokens")
}

model NotificationPreference {
  userId           String  @id @map("user_id") @db.Uuid
  prayerReminders  Boolean @default(true) @map("prayer_reminders")
  leagueAlerts     Boolean @default(true) @map("league_alerts")
  streakWarnings   Boolean @default(true) @map("streak_warnings")
  friendActivity   Boolean @default(false) @map("friend_activity")
  questUpdates     Boolean @default(true) @map("quest_updates")

  user User @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

model ParentalConsent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  parentPhoneHash String    @map("parent_phone_hash") @db.VarChar(64)
  consentToken    String    @unique @map("consent_token") @db.VarChar(64)
  tokenExpiresAt  DateTime  @map("token_expires_at") @db.Timestamptz(6)
  status          String    @default("PENDING") @db.VarChar(20)
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(6)
  resendCount     Int       @default(0) @map("resend_count") @db.SmallInt
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("parental_consents")
}

model Masjid {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String   @db.VarChar(100)
  addressLine1         String   @map("address_line1") @db.VarChar(100)
  addressLine2         String?  @map("address_line2") @db.VarChar(100)
  city                 String   @db.VarChar(60)
  postcode             String   @db.VarChar(10)
  latitude             Decimal  @db.Decimal(9, 6)
  longitude            Decimal  @db.Decimal(9, 6)
  geofenceRadiusMetres Int      @default(200) @map("geofence_radius_metres")
  adminUserId          String?  @map("admin_user_id") @db.Uuid
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       User[]
  nfcTags     NfcTag[]
  prayerTimes MasjidPrayerTime[]
  checkins    Checkin[]
  leagueGroups LeagueGroup[]
  quests      Quest[]
  vendors     Vendor[]
  adminUsers  AdminUser[]

  @@map("masajid")
}

model NfcTag {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  masjidId  String    @map("masjid_id") @db.Uuid
  tagId     String    @unique @map("tag_id") @db.VarChar(32)
  label     String    @default("Main Prayer Hall") @db.VarChar(60)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)

  masjid Masjid @relation(fields: [masjidId], references: [id])

  @@map("nfc_tags")
}

model MasjidPrayerTime {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  masjidId         String     @map("masjid_id") @db.Uuid
  date             DateTime   @db.Date
  prayer           PrayerName
  jamaatTime       DateTime   @map("jamaat_time") @db.Time(0)
  windowCloseTime  DateTime   @map("window_close_time") @db.Time(0)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  masjid Masjid @relation(fields: [masjidId], references: [id])

  @@unique([masjidId, date, prayer], map: "uq_prayer_time")
  @@index([masjidId, date], map: "idx_prayer_times_lookup")
  @@map("masjid_prayer_times")
}

model Checkin {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String     @map("user_id") @db.Uuid
  masjidId             String     @map("masjid_id") @db.Uuid
  tagId                String     @map("tag_id") @db.VarChar(32)
  prayer               PrayerName
  prayerDate           DateTime   @map("prayer_date") @db.Date
  checkedInAt          DateTime   @map("checked_in_at") @db.Timestamptz(6)
  xpAwarded            Int        @default(0) @map("xp_awarded")
  creditsAwarded       Int        @default(0) @map("credits_awarded")
  bonuses              Json       @default("[]")
  isJumuah             Boolean    @default(false) @map("is_jumuah")
  isFullDayCompleting  Boolean    @default(false) @map("is_full_day_completing")
  gpsLatitude          Decimal?   @map("gps_latitude") @db.Decimal(9, 6)
  gpsLongitude         Decimal?   @map("gps_longitude") @db.Decimal(9, 6)
  gpsAccuracyMetres    Float?     @map("gps_accuracy_metres")
  clientNonce          String     @unique @map("client_nonce") @db.Uuid
  flaggedForReview     Boolean    @default(false) @map("flagged_for_review")
  flagReason           String?    @map("flag_reason")

  user   User   @relation(fields: [userId], references: [id])
  masjid Masjid @relation(fields: [masjidId], references: [id])

  @@unique([userId, prayer, prayerDate], map: "uq_checkin_per_prayer_per_day")
  @@index([userId, prayerDate(sort: Desc)], map: "idx_checkins_user_date")
  @@index([masjidId, prayerDate(sort: Desc)], map: "idx_checkins_masjid_date")
  @@map("checkins")
}

model MainStreak {
  userId          String    @id @map("user_id") @db.Uuid
  currentStreak   Int       @default(0) @map("current_streak")
  lastCheckinDate DateTime? @map("last_checkin_date") @db.Date
  longestStreak   Int       @default(0) @map("longest_streak")
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("main_streaks")
}

model PrayerMicroStreak {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  prayer             MicroStreakPrayer
  microStreak        Int                @default(0) @map("micro_streak")
  lastAttendedDate   DateTime?          @map("last_attended_date") @db.Date
  longestMicroStreak Int                @default(0) @map("longest_micro_streak")
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, prayer], map: "uq_micro_streak")
  @@map("prayer_micro_streaks")
}

model LeagueTier {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String @unique @db.VarChar(20)
  tierOrder Int    @unique @map("tier_order") @db.SmallInt
  iconKey   String @map("icon_key") @db.VarChar(40)
  colourHex String @map("colour_hex") @db.VarChar(7)

  groups LeagueGroup[]

  @@map("league_tiers")
}

model LeagueWeek {
  weekId   String   @id @map("week_id") @db.VarChar(10)
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  groups  LeagueGroup[]
  results LeagueWeeklyResult[]

  @@map("league_weeks")
}

model LeagueGroup {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  masjidId      String   @map("masjid_id") @db.Uuid
  tierId        String   @map("tier_id") @db.Uuid
  currentWeekId String   @map("current_week_id") @db.VarChar(10)
  maxMembers    Int      @default(30) @map("max_members") @db.SmallInt
  locked        Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  masjid       Masjid               @relation(fields: [masjidId], references: [id])
  tier         LeagueTier           @relation(fields: [tierId], references: [id])
  currentWeek  LeagueWeek           @relation(fields: [currentWeekId], references: [weekId])
  memberships  LeagueMembership[]
  weeklyResults LeagueWeeklyResult[]

  @@map("league_groups")
}

model LeagueMembership {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  leagueGroupId String   @map("league_group_id") @db.Uuid
  weeklyXp      Int      @default(0) @map("weekly_xp")
  joinedAt      DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  user  User        @relation(fields: [userId], references: [id])
  group LeagueGroup @relation(fields: [leagueGroupId], references: [id])

  @@index([leagueGroupId], map: "idx_memberships_group")
  @@index([leagueGroupId, weeklyXp(sort: Desc)], map: "idx_memberships_weekly_xp")
  @@map("league_memberships")
}

model LeagueWeeklyResult {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leagueGroupId  String   @map("league_group_id") @db.Uuid
  weekId         String   @map("week_id") @db.VarChar(10)
  userId         String   @map("user_id") @db.Uuid
  finalRank      Int      @map("final_rank") @db.SmallInt
  finalWeeklyXp  Int      @map("final_weekly_xp")
  outcome        String   @db.VarChar(12)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  group LeagueGroup @relation(fields: [leagueGroupId], references: [id])
  week  LeagueWeek  @relation(fields: [weekId], references: [weekId])
  user  User        @relation(fields: [userId], references: [id])

  @@map("league_weekly_results")
}

model Badge {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique @db.VarChar(40)
  name        String @db.VarChar(60)
  description String @db.VarChar(200)
  iconKey     String @map("icon_key") @db.VarChar(40)
  category    String @db.VarChar(20)
  sortOrder   Int    @default(0) @map("sort_order") @db.SmallInt

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  badgeId  String   @map("badge_id") @db.Uuid
  earnedAt DateTime @default(now()) @map("earned_at") @db.Timestamptz(6)
  viewed   Boolean  @default(false)

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId], map: "uq_user_badge")
  @@map("user_badges")
}

model Quest {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  masjidId        String?    @map("masjid_id") @db.Uuid
  title           String     @db.VarChar(80)
  description     String
  type            QuestType
  targetPrayer    PrayerName? @map("target_prayer")
  targetValue     Int        @map("target_value")
  rewardXp        Int        @default(0) @map("reward_xp")
  rewardCredits   Int        @default(0) @map("reward_credits")
  startDate       DateTime   @map("start_date") @db.Timestamptz(6)
  endDate         DateTime   @map("end_date") @db.Timestamptz(6)
  isFeatured      Boolean    @default(false) @map("is_featured")
  status          String     @default("DRAFT") @db.VarChar(10)
  createdByAdminId String    @map("created_by_admin_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  masjid   Masjid?             @relation(fields: [masjidId], references: [id])
  progress UserQuestProgress[]

  @@map("quests")
}

model UserQuestProgress {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  questId         String    @map("quest_id") @db.Uuid
  currentProgress Int       @default(0) @map("current_progress")
  status          String    @default("ACTIVE") @db.VarChar(12)
  assignedAt      DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id])
  quest Quest @relation(fields: [questId], references: [id])

  @@unique([userId, questId], map: "uq_user_quest")
  @@map("user_quest_progress")
}

model Vendor {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  masjidId     String   @map("masjid_id") @db.Uuid
  name         String   @db.VarChar(80)
  type         String   @db.VarChar(20)
  pinHash      String   @map("pin_hash") @db.VarChar(60)
  contactEmail String?  @map("contact_email") @db.VarChar(255)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  masjid      Masjid       @relation(fields: [masjidId], references: [id])
  rewards     Reward[]
  redemptions Redemption[]

  @@map("vendors")
}

model Reward {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId            String    @map("vendor_id") @db.Uuid
  title               String    @db.VarChar(80)
  description         String?
  creditCost          Int       @map("credit_cost")
  dailyLimitPerUser   Int?      @map("daily_limit_per_user") @db.SmallInt
  totalRedemptionCap  Int?      @map("total_redemption_cap")
  totalRedeemed       Int       @default(0) @map("total_redeemed")
  isActive            Boolean   @default(true) @map("is_active")
  startsAt            DateTime? @map("starts_at") @db.Timestamptz(6)
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  redemptions Redemption[]

  @@map("rewards")
}

model Redemption {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  vendorId        String   @map("vendor_id") @db.Uuid
  rewardId        String   @map("reward_id") @db.Uuid
  creditsDeducted Int      @map("credits_deducted")
  vendorPinHash   String   @map("vendor_pin_hash") @db.VarChar(60)
  status          String   @default("COMPLETED") @db.VarChar(12)
  pinAttempts     Int      @default(1) @map("pin_attempts") @db.SmallInt
  redeemedAt      DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)
  balanceAfter    Int      @map("balance_after")

  user   User   @relation(fields: [userId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])
  reward Reward @relation(fields: [rewardId], references: [id])

  @@map("redemptions")
}

model FriendRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromUserId  String    @map("from_user_id") @db.Uuid
  toUserId    String    @map("to_user_id") @db.Uuid
  status      String    @default("PENDING") @db.VarChar(10)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(6)

  fromUser User @relation("FriendRequestFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("FriendRequestTo", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId], map: "uq_friend_request")
  @@map("friend_requests")
}

model FriendRelationship {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userIdA   String   @map("user_id_a") @db.Uuid
  userIdB   String   @map("user_id_b") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userIdA, userIdB], map: "uq_friendship")
  @@map("friend_relationships")
}

model Referral {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerUserId  String    @map("referrer_user_id") @db.Uuid
  refereeUserId   String    @unique @map("referee_user_id") @db.Uuid
  bonusCredited   Boolean   @default(false) @map("bonus_credited")
  bonusCreditedAt DateTime? @map("bonus_credited_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  referrer User @relation("Referrer", fields: [referrerUserId], references: [id])
  referee  User @relation("Referee", fields: [refereeUserId], references: [id])

  @@map("referrals")
}

model AdminUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  masjidId     String    @map("masjid_id") @db.Uuid
  name         String    @db.VarChar(80)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(60)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  masjid    Masjid          @relation(fields: [masjidId], references: [id])
  auditLogs AdminAuditLog[]

  @@map("admin_users")
}

model AdminAuditLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId      String   @map("admin_user_id") @db.Uuid
  actionType       String   @map("action_type") @db.VarChar(40)
  targetUserId     String?  @map("target_user_id") @db.Uuid
  targetResourceId String?  @map("target_resource_id") @db.Uuid
  details          Json?
  ipAddress        String   @map("ip_address") @db.Inet
  performedAt      DateTime @default(now()) @map("performed_at") @db.Timestamptz(6)

  admin AdminUser @relation(fields: [adminUserId], references: [id])

  @@map("admin_audit_log")
}

/// Pilot stand-in for Redis key/value (Architecture v2 — Redis deferred).
model CacheEntry {
  key       String   @id @db.VarChar(255)
  value     String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("cache_entries")
}
